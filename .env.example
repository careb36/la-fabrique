# Database
# Postgres is used when these three are set. For a local single-user
# install without Docker, set DATABASE_URL instead (run_fusion.py does it for
# you): DATABASE_URL=sqlite:///./factory.db
POSTGRES_USER=factory
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=factory
DATABASE_URL=

# Neo4j
NEO4J_AUTH=neo4j/your_neo4j_password
NEO4J_PASSWORD=your_neo4j_password

# LLM (Gemini) — optional, not used when switching to DeepSeek+Qwen
GEMINI_API_KEY=

# DeepSeek (Developer/QA/Engram processing)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Qwen (Alibaba Cloud DashScope) — used for PO, Architect, SecOps
QWEN_API_KEY=your_qwen_api_key

# Nebius Token Factory — serves the NVIDIA open models (Nemotron). Model ids
# carry a vendor segment, e.g. nvidia/Llama-3.1-Nemotron-70B-Instruct.
NEBIUS_API_KEY=your_nebius_token_factory_api_key
# Point this at a Nebius Serverless Endpoint if you deploy your own.
NEBIUS_PROXY_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA's catalog gateway (integrate.api.nvidia.com) — same model ids, key
# starting with nvapi-. When both keys are set, nvidia/... ids are sent here
# first and Nebius stays as the alternative host.
NVIDIA_API_KEY=your_nvidia_nvapi_key
NVIDIA_PROXY_URL=https://integrate.api.nvidia.com/v1

# LLM proxy: time budget for one chat request's provider calls, fallbacks
# included. Keep it below the backend task client's 120 s timeout.
LLM_UPSTREAM_TIMEOUT_SECONDS=110

# Which agent roles run on NVIDIA Nemotron (served by Nebius Token Factory).
# Empty means the Qwen/DeepSeek defaults in backend/llm/model_factory.py. The
# names are AgentRole.value in lower case — «ScrumMaster» is `scrummaster`, not
# `scrum_master`: a name that does not match is ignored in silence and that role
# keeps asking the proxy for a model nobody authorised.
# Two tiers on one provider: Ultra thinks (planning, architecture, security),
# Super answers (implementation, reviews) so credits go further.
NEMOTRON_ROLES=po,architect,scrummaster,developer,qa,secops,techwriter,engramprocessor
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_MODEL_STRATEGIC=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
# Model every role uses when NEMOTRON_ROLES does not name it.
AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Credential encryption (optional but recommended)
# Encrypts ProjectCredential values at rest. Without it they are stored with a
# "plaintext:" prefix and the backend warns at startup. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=

# JWT authentication (separate from FERNET_SECRET_KEY)
# Used to sign access tokens. Login returns 503 until this is configured.
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Authentication enforcement is on by default. Set false only for a local demo without a login.
AUTH_REQUIRED=true

# Voice control (the desktop assistant, Asistente B1, speaks to /v1/voice/*)
# Shared secret the assistant sends as the X-Voice-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset with AUTH_REQUIRED=true means the voice routes answer 503 instead of
# opening anonymously.
VOICE_API_KEY=
# Company the voice routes use when the assistant does not name one. Empty means
# the oldest company (the natural choice for a single-tenant install).
VOICE_COMPANY_ID=

# Login, registration and the desktop key exchange, per client address.
AUTH_RATE_LIMIT=10/minute

# Audit signing (optional but recommended)
# Signs audit rows with HMAC-SHA256. Without it, rows carry an "unsigned:" prefix.
# Keep this key separate from FERNET_SECRET_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SIGNING_KEY=

# Optional GitHub API token for backfill and webhook rate-limit headroom
GITHUB_TOKEN=
# Address GitHub uses to reach this backend for webhooks (the public host or a
# tunnel, e.g. https://fabrique.example.com). The GitHub page shows it as the
# webhook Payload URL; without it, the page falls back to the browser's API URL.
PUBLIC_API_URL=

# Support desk admins (comma-separated account emails). They see and triage every
# ticket and download the support logs; everyone else sees only the tickets they
# reported with their account email.
SUPPORT_ADMIN_EMAILS=
# The Support agent triages new tickets (suggested severity and category, a first
# reply to the reporter). Off by default: reporting a bug is public, and each new
# ticket costs an LLM call.
SUPPORT_AGENT_ENABLED=false
# The Reviewer agent suggests the decision on other producers' runs; a Manager decides.
REVIEWER_AGENT_ENABLED=false

# Optional overrides
# Enable the internal LangGraph producer.
AGENT_GRAPH_ENABLED=false
# Run the project's tests after an agent's files are written and record the exit
# status as evidence. Off by default: it executes agent-written code on the machine
# running the VS Code daemon. DELIVERY_TEST_COMMAND overrides detection (npm test / pytest).
DELIVERY_TESTS_ENABLED=false
DELIVERY_TEST_COMMAND=
NATS_URL=nats://nats:4222
# Prefijo opcional para los nombres de streams, consumidores y subjects de
# JetStream. Poné uno distinto en cada despliegue que comparta un mismo NATS
# (por ejemplo `e2e` para la corrida end-to-end): los streams son work-queue,
# así que dos stacks con los mismos nombres se roban los mensajes entre sí.
NATS_NAMESPACE=
BACKEND_URL=http://localhost:8000
LLM_PROXY_URL=http://llm-proxy:5100
# How long the backend waits for one proxy answer. It must outlast the
# proxy's own upstream budget (LLM_UPSTREAM_TIMEOUT_SECONDS, 110 s) or the
# backend declares the proxy dead while it is still writing files.
LLM_PROXY_TIMEOUT_SECONDS=150
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# Set true on a desktop install with no Neo4j: memory search is unavailable and
# startup fails fast instead of waiting for the bolt driver's timeout.
NEO4J_DISABLED=false
CONTAINER_WORKSPACE_ROOT=/workspace
# The workspace daemon runs on your computer (scripts/start-daemon.sh on
# macOS/Linux, scripts/start-daemon.ps1 on Windows) and connects to NATS on
# localhost:4222. NATS_BIND=0.0.0.0 exposes NATS to other machines; only do
# that on a trusted network, since NATS clients can ask the daemon to run commands.
# NATS_BIND=127.0.0.1
# Address every other published port (API, UI, databases, LLM proxy, tracing)
# listens on. Loopback by default: the databases and the proxy have no login of
# their own worth exposing. Set 0.0.0.0 only behind a firewall you control.
# BIND_ADDRESS=127.0.0.1
# Only for the optional Linux-only daemon container
# (docker compose --profile docker-daemon up): the host folder with your
# projects, mounted at the same path. Defaults to your home directory.
# PROJECTS_ROOT=/absolute/path/to/your/projects

# Carpeta donde la fábrica escribe los proyectos pedidos por chat
# (POST /v1/voice/build). En Docker apunta al workspace montado.
FABRICA_BUILDS_DIR=/workspace/builds
