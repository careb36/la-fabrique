# ==========================================
# La Fabrique — .gitignore
# ==========================================

# --- OS ---
.DS_Store
Thumbs.db
*.swp
*.tmp
*.bak

# --- Secrets & Environment (CRITICAL — never commit real credentials) ---
# Matches .env and every .env.<suffix> (.env.production, .env.staging, .env.test,
# ...), not just .env.local. The example file is re-included below, and must stay
# the only tracked one: this repository is public.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
.htpasswd
.npmrc
.pypirc
certs/
secrets/
password.txt

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Audit / JSONL runtime files ---
*.jsonl
!backend/app/audit_schema.jsonl.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage.xml
htmlcov/
coverage/
.venv/
# venv de Poetry en CI cuando se fija en el workspace
.poetry-backend/
.poetry-llm/
venv/
ENV/
*.egg-info/
.mypy_cache/
.ruff_cache/
.tox/
*.orig
*.rej

# --- Python build artifacts (NOT the project's build/ asset folder) ---
backend/build/
llm-proxy/build/
vscode-daemon/build/

# --- Node.js ---
node_modules/
.eslintcache
*.log

# --- Frontend build output ---
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/
frontend/coverage/
*.tsbuildinfo

# --- Test tooling reports ---
test-results/
playwright-report/
.playwright/

# --- VS Code extension compiled output ---
vscode-extension/out/
vscode-extension/dist/

# --- Electron distribution packages ---
dist-electron/
dist-electron-main/
release/
*.dmg
*.exe
*.AppImage

# --- Databases (runtime data, NOT init scripts in db/) ---
postgres-data/
neo4j-data/
neo4j-logs/
nats-data/
*.sqlite
*.sqlite3
*.db
# SQL dump/backup files only (NOT db/init-db/init.sql)
backup_*.sql
dump_*.sql
*_dump.sql
*.tar
*.gz

# --- LangGraph checkpoints ---
langgraph_checkpoints/
*.checkpoint

# --- IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace

# --- Project runtime artifacts ---
.factory/
# Runtime state of the merged desktop install (run_fusion.py): SQLite database
# used when no Postgres is configured.
.fusion/
factory-workspaces/
support_logs/
engrams_backup/

# --- Stale / removed services ---
openproject-data/
openproject/

# ==========================================

# --- Memoria local de agentes (nunca versionar: el repo es publico) ---
.openhands/

# Projects generated from a chat sentence (/v1/voice/build).
builds/
